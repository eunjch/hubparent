# 웹앱 빌드 설정
#
# 브라우저에서 서버 도메인으로 여는 경우에는 아무것도 설정하지 않아도 된다.
# 아파치가 같은 도메인의 /api/ 를 컨테이너로 넘기므로 상대 경로로 동작한다.
#
# Capacitor 앱으로 빌드할 때만 절대 주소가 필요하다 (앱 오리진은 https://localhost).
# VITE_API_BASE_URL=https://hubfamily.mangotree.co.kr

# 로컬 개발 시 vite 개발 서버가 /api 를 넘길 대상. 기본 http://127.0.0.1:8000
# VITE_DEV_API_TARGET=http://127.0.0.1:18000
