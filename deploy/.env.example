# HUB FAMILY 환경변수 예시
# 실제 값을 채운 뒤 .env 로 복사한다.  서버에서는 권한 600 으로 둘 것.
#   cp .env.example .env && chmod 600 .env
# 이 파일에는 절대 실제 비밀번호를 적지 않는다.

# ── 실행 환경 ─────────────────────────────────────────
ENV=dev                       # dev | prod
APP_TIMEZONE=Asia/Seoul
PUBLIC_BASE_URL=http://127.0.0.1:8000
API_HOST_PORT=8000            # 로컬에서 8000 이 겹칠 때만 바꾼다

# ── 보안 ──────────────────────────────────────────────
# 생성:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=180        # 어르신 재로그인을 만들지 않기 위해 길게 잡는다

# ── PostgreSQL (컨테이너 내부에서만 접근) ─────────────
POSTGRES_DB=hubfamily
POSTGRES_USER=hubfamily
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis (컨테이너 내부. 호스트의 6379 와 무관) ──────
REDIS_URL=redis://redis:6379/0

# ── 파일 업로드 ───────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=8

# ── 알림 임계값 (계획서 8장) ──────────────────────────
MED_REMIND_L1_MINUTES=30      # 복약 예정 +30분 미응답 → 재알림
MED_REMIND_L2_MINUTES=120     # +2시간 미응답 → 보호자 앱 표시
MED_ESCALATION=false          # 재알림(L1·L2) 푸시. 보류 중 — true 로 켠다
NO_RESPONSE_HOURS=24          # 생존신호 미수신 → 이상 징후 알림
ALERT_SCAN_INTERVAL_MINUTES=15
DAILY_REPORT_HOUR=21          # KST 기준 일일 리포트 생성 시각

# ── 메일 (M4 리포트 메일) ─────────────────────────────
# 네이버웍스 SMTP. 인증 계정 주소로만 발신된다 — From 을 사용자 주소로 못 바꾼다.
# 표시 이름만 MAIL_FROM_NAME 으로 바뀌고, 답장은 Reply-To 로 받는다.
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=HUB FAMILY

# ── SMS 본인인증 (M3 에서 채움) ───────────────────────
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NUMBER=

# ── 푸시 ─────────────────────────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 → deploy/firebase-adminsdk.json 으로 저장.
# docker-compose 가 컨테이너 안 /run/secrets/ 로 넣어 준다. 비우면 푸시는 이력만 남기고 보내지 않는다.
FCM_CREDENTIALS_PATH=/run/secrets/firebase-adminsdk.json
# iOS 는 FCM 이 아니라 애플에 직접 보낸다 — 앱이 주는 토큰이 APNs 토큰이라서.
# 애플 개발자 사이트 → Certificates, Identifiers & Profiles → Keys → + → Apple Push Notifications service
# 받은 .p8 을 deploy/apns-key.p8 으로 저장. 한 번만 받을 수 있으니 따로 보관할 것.
# Key ID 는 키 이름 옆에, Team ID 는 사이트 오른쪽 위 멤버십에 있다. 비우면 iOS 는 이력만 남는다.
APNS_KEY_PATH=/run/secrets/apns-key.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=kr.co.mangotree.hubfamily
# Xcode 로 폰에 직접 설치해 시험하는 동안은 true. TestFlight·App Store 배포는 false
APNS_SANDBOX=false
